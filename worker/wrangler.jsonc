{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ironwood-verifier",
  "main": "index.mjs",
  "compatibility_date": "2026-10-27",
  "workers_dev": true,
  "vars": {
    "ALLOWED_ORIGIN": "https://lancekrogers.github.io"
  },
  "ratelimits": [{
    "name": "VERIFY_LIMIT",
    "namespace_id": "730071",
    "simple": {"limit": 6, "period": 60}
  }],
  "observability": {
    "enabled": true,
    "traces": {"enabled": true, "head_sampling_rate": 0.1}
  }
}
